# Overlay on/off lives in ~/.openbundle/overlay.yaml (`openbundle on` / `openbundle off`).
# OPENBUNDLE_ENABLED and --passthrough override that file.
listen: 127.0.0.1:4180   # binds loopback only; --expose required for 0.0.0.0
providers:
  anthropic:
    api_key: env:ANTHROPIC_API_KEY
    base_url: https://api.anthropic.com
  openai:
    api_key: env:OPENAI_API_KEY
    base_url: https://api.openai.com/v1
bundle:
  cache: sqlite_exact    # OpenBundle exact-hash cache (first-party, MIT)
  compress: none         # LLMLingua-2 after extra + smoke-check
  routing: prefix_router
  guardrails: input_guard
  structured: json_schema
  eval: sample_eval
  memory: none           # advisory — never auto-enabled
layers:
  cache:
    enabled: true
    semantic: false
  compress:
    enabled: false
    rate: 0.5
    skip_cache_control: true
    adapter: llmlingua2
  routing:
    enabled: false
    adapter: prefix_router
  guardrails:
    enabled: false
    adapter: input_guard
  structured:
    enabled: false
    adapter: json_schema
  eval:
    enabled: false
    adapter: sample_eval
  memory:
    enabled: false
    user_id: local
    extract:
      every_n_turns: 3
      min_interval_seconds: 15
      max_per_minute: 4
      skip_if_user_tokens_below: 50

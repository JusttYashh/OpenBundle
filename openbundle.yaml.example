# Overlay on/off lives in ~/.openbundle/overlay.yaml (`openbundle on` / `openbundle off`).
listen: 127.0.0.1:4180
providers:
  anthropic:
    api_key: env:ANTHROPIC_API_KEY
    base_url: https://api.anthropic.com
  openai:
    api_key: env:OPENAI_API_KEY
    base_url: https://api.openai.com/v1
bundle:
  cache: sqlite_exact
  coalesce: singleflight
  memory: summary
  context: session_hygiene
  compress: none
  prompt_cache: prompt_cache
  routing: prefix_router
  guardrails: input_guard
  structured: json_schema
  eval: sample_eval
  batch: none
layers:
  cache:
    enabled: true
    semantic: false
  coalesce:
    enabled: false
    adapter: singleflight
  memory:
    enabled: false
    user_id: local
    adapter: summary
    extract:
      every_n_turns: 3
      min_interval_seconds: 15
      max_per_minute: 4
      skip_if_user_tokens_below: 50
  context:
    enabled: false
    adapter: session_hygiene
    window: 40
  compress:
    enabled: false
    rate: 0.5
    skip_cache_control: true
    adapter: llmlingua2
  prompt_cache:
    enabled: false
    adapter: prompt_cache
  routing:
    enabled: false
    adapter: prefix_router
  guardrails:
    enabled: false
    adapter: input_guard
  structured:
    enabled: false
    adapter: json_schema
  eval:
    enabled: false
    adapter: sample_eval
  batch:
    enabled: false
    adapter: none

[0.05,"o","$ openbundle init --no-banner\r\n"]
[0.09,"o","OpenBundle initialized. Jobs:\r\n"]
[0.13,"o","  \u2713 exact-hash cache       \u2192 OpenBundle exact-hash cache (first-party, MIT)\r\n"]
